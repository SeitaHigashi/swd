{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window and the settings window",
  "windows": ["main", "settings"],
  "permissions": [
    "core:default",
    "core:window:allow-outer-position",
    "core:event:default",
    "opener:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "*:*" }]
    },
    {
      "identifier": "http:default",
      "allow": [{ "url": "*://*/*" }]
    }
  ]
}
