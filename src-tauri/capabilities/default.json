{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-outer-position",
    "core:event:default",
    "opener:default",
    {
      "identifier": "http:default",
      "allow": [{ "url": "https://api.nature.global/*" }]
    }
  ]
}
